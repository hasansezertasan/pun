{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "--tb=short"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": false
    },
    
    
    {
      // debugpy's `args` is Array[string] and VS Code substitutes an input into
      // a single array element, so a free-text prompt cannot be split into
      // separate arguments: "version --help" would arrive as one token, and the
      // old empty default sent `uv run pun ""`, which Typer rejects with
      // "No such command ''" instead of showing the root help. A pickString
      // keeps every value a single token, so each choice is always valid.
      // To debug a command with flags, edit "args" below directly.
      "name": "Python: CLI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "pun", "${input:command}"]
    },
    
    
    {
      "name": "Python: TUI",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": true,
      "module": "uv",
      "args": ["run", "pun", "interactive"]
    },
    
    
    
  ],
  "inputs": [
    {
      "id": "command",
      "type": "pickString",
      "options": ["version", "info", "interactive"],
      "default": "version",
      "description": "pun command to debug"
    }
  ]
}
